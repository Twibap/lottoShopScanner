{$API_DOMAIN} {
	encode zstd gzip
	redir / /lottoshoprank/ 308
	redir /lottoshoprank /lottoshoprank/ 308

	handle_path /lottoshoprank/* {
		reverse_proxy frontend:80
	}

	# 웹은 같은 출처의 /api를 사용하고, 기존 공개 API 경로는 유지한다.
	handle_path /api/* {
		reverse_proxy backend:8000
	}
	handle /v1/* {
		reverse_proxy backend:8000
	}
	handle /health* {
		reverse_proxy backend:8000
	}
	handle /docs* {
		reverse_proxy backend:8000
	}
	handle /openapi.json {
		reverse_proxy backend:8000
	}
	handle {
		reverse_proxy backend:8000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		-Server
	}

	log
}
